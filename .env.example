# Epsilon Environment Configuration
# SEC-1: EXPO_PUBLIC_* variables are inlined into client JS at build time.
# Never place server secrets, private API keys, or database credentials here.

# Application Environment: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# API Mode: mock | live
# SEC-9: 'mock' is strictly forbidden in production (EXPO_PUBLIC_APP_ENV=production)
EXPO_PUBLIC_API_MODE=mock

# API Base URL:
# Development / Staging: http:// or https:// (e.g. http://10.0.2.2:3000/v1 for Android emulator)
# Production (SEC-9): Must be an explicitly configured public HTTPS domain.
# TODO: Supply legitimate production API base URL when backend deployment/domain is finalized.
# Do NOT invent or hardcode placeholders or unverified domains.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/v1

# Minimum signup age (integer, defaults to 16)
EXPO_PUBLIC_MIN_AGE=16

# Support email for inquiries and user assistance
EXPO_PUBLIC_SUPPORT_EMAIL=support@epsilonup.app

# Legal URLs (SEC-7: opened via expo-web-browser)
EXPO_PUBLIC_PRIVACY_URL=https://epsilonup.app/privacy
EXPO_PUBLIC_TERMS_URL=https://epsilonup.app/terms

# Google Sign-in OAuth Web Client ID (Google Cloud Console web client ID)
# Required only if ENABLE_GOOGLE_SIGNIN=true
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Feature flags: true | false (default false)
ENABLE_GOOGLE_SIGNIN=false
ENABLE_APPLE_SIGNIN=false

# Non-production API URLs: comma-separated list of URLs rejected if used in production
NON_PRODUCTION_API_URLS=
