{
  "name": "epsilon",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "node scripts/generate-route-types.cjs && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "guard:production": "node scripts/production-guard.cjs",
    "supply-chain:check": "node scripts/check-supply-chain.cjs",
    "bundle:check": "node scripts/bundle-report.cjs",
    "i18n:check": "node scripts/check-i18n.cjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run i18n:check && npm run format:check && npm run guard:production && npm run supply-chain:check && npm run android:audit && npm run workflows:check && npm run contract:check",
    "prepare": "husky",
    "android:audit": "node scripts/audit-android.cjs",
    "crash:sourcemaps": "node scripts/upload-sourcemaps.cjs",
    "export:android": "node scripts/export-android.cjs",
    "secrets:check": "node scripts/scan-secrets.cjs",
    "workflows:check": "node scripts/check-workflows.cjs",
    "eas-build-post-install": "node scripts/eas-preflight.cjs",
    "contract:generate": "node scripts/generate-openapi.cjs",
    "contract:check": "node scripts/generate-openapi.cjs --check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@sentry/react-native": "8.28.0",
    "@shopify/flash-list": "2.3.2",
    "@tanstack/react-query": "5.105.0",
    "expo": "58.0.22",
    "expo-build-properties": "58.0.12",
    "expo-camera": "58.0.14",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.18",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.15",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.7",
    "expo-router": "58.0.29",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-web-browser": "58.0.7",
    "i18next": "26.5.12",
    "lucide-react-native": "1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-i18next": "17.1.9",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.6"
    }
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  }
}
