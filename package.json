{
  "name": "epsilon",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "i18n:check": "node scripts/check-i18n.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run i18n:check && npm run format:check",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "58.0.21",
    "expo-build-properties": "58.0.11",
    "expo-camera": "58.0.14",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.17",
    "expo-haptics": "58.0.7",
    "expo-linking": "58.0.15",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.28",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "lucide-react-native": "1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "eslint-import-resolver-typescript": "4.4.5",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-expo": "58.0.13",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "react-server-dom-webpack": "19.3.0",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@expo/cli": {
      "zod": "4.6.6"
    }
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --max-warnings=0",
      "prettier --check"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --check"
    ]
  }
}
